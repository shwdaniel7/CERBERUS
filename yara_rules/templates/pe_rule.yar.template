//
// TEMPLATE — PE / file-header rule.
//
// Uses YARA "condition helpers" to test the file structure instead of only
// searching raw strings. See https://yara.readthedocs.io/ for the full list.
//
// Useful helpers:
//   uint16(0) / uint32(offset)  integer read at a byte offset (LE)
//   filesize                    size of the scanned file in bytes
//   entrypoint  / pe.number_of_sections / pe.exports("name")  (PE module)
//   $a at X / $a in (X..Y)      string offset pinning / range
//
// HOW TO USE: same copy/edit/place flow as string_rule.yar.template.
//
rule my_pe_rule : pe {
    meta:
        description = "PE with suspicious section import (template)"
        author = "your name"
        severity = "medium"
        reference = "https://example.com"

    strings:
        $import = "kernel32.dll" nocase
        $sect = "UPX0"

    condition:
        uint16(0) == 0x5A4D              // starts with "MZ" -> it IS a PE
        and filesize > 0
        and filesize < 100 * 1024 * 1024 // cap to avoid huge scans
        and ($import or $sect)
}